generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  CLIENT
  PROFESSIONAL
  EVALUATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ProfessionalStatus {
  PENDING
  VERIFIED
  CERTIFIED
  SUSPENDED
  REFUSED
}

enum SpecialtyCode {
  BUILDING_REPAIR
  INDUSTRIAL
  SOLAR_PV
  GENERATORS
  PANELS_THREE_PHASE
}

enum DocumentType {
  ID_CARD
  PROFILE_PHOTO
  DIPLOMA
  PROFESSIONAL_CERTIFICATE
  REFERENCE_LETTER
  WORK_PHOTO
  BREAKDOWN_PHOTO
}

enum DocumentStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
  EXPIRED
}

enum ClientPlatform {
  WEB
  ANDROID
  IOS
  UNKNOWN
}

enum OtpChannel {
  SMS
  WHATSAPP
}

enum DeliveryStatus {
  QUEUED
  SENT
  FAILED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DataRequestType {
  EXPORT
  RECTIFICATION
  DELETION
}

enum DataRequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum DocumentEventType {
  UPLOADED
  APPROVED
  REJECTED
  EXPIRED
  ACCESSED
  VIEW_LINK_ISSUED
}

enum VerificationDecisionType {
  VERIFIED
  REFUSED
  COMPLEMENT_REQUESTED
}

enum VerifiedReasonCode {
  VERIFIED_OK
  DOCUMENT_MISSING
  DOCUMENT_UNREADABLE
  DOCUMENT_EXPIRED
  DOCUMENT_MISMATCH
  EXPERIENCE_INSUFFICIENT
  SPECIALTY_NOT_JUSTIFIED
  ZONE_NOT_COVERED
  OTHER
}

enum AuditResult {
  SUCCESS
  DENIED
}

enum DevicePlatform {
  WEB
  ANDROID
  IOS
}

enum PushProvider {
  FCM
  WEB_PUSH
  EXPO
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum NotificationType {
  VERIFICATION_APPROVED
  VERIFICATION_REFUSED
  COMPLEMENT_REQUESTED
  DOCUMENT_EXPIRING
  DOCUMENT_EXPIRED
  ADMIN_DOCUMENT_EXPIRING
  EVALUATION_ASSIGNED
  EVALUATION_SUBMITTED
  CERTIFICATION_OBTAINED
  SERVICE_REQUEST_CREATED
  SERVICE_REQUEST_CANCELLED
  PROPOSAL_RECEIVED
  PROPOSAL_ACCEPTED
  MISSION_CREATED
  ARRIVAL_CODE_READY
  ARRIVAL_CODE_VERIFIED
  PROFESSIONAL_REASSIGNED
  MESSAGE_RECEIVED
  QUOTE_SUBMITTED
  QUOTE_ACCEPTED
  QUOTE_REJECTED
  WORK_AUTHORIZED
  MISSION_COMPLETED
  REPORT_READY
  MISSION_CLOSED
  PAYMENT_CONFIRMED
  SUBSCRIPTION_ACTIVATED
  REVIEW_RECEIVED
  REVIEW_RESPONSE_RECEIVED
  CLAIM_OPENED
  CLAIM_STATUS_CHANGED
  GUARANTEE_ACTIVATED
  SUSPENSION_APPLIED
  SUSPENSION_LIFTED
  APPEAL_DECIDED
}

enum EvaluationAssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
}

enum ServiceRequestType {
  ELECTRICAL_FAILURE
  GENERATOR_FAILURE
  SOLAR_FAILURE
  PANEL_FAILURE
  OTHER
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ServiceRequestStatus {
  OPEN
  MATCHED
  ACCEPTED
  CANCELLED
  COMPLETED
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  UNAVAILABLE
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum MissionStatus {
  ACCEPTED
  CODE_VERIFIED
  PENDING_QUOTE
  WORK_AUTHORIZED
  COMPLETED
  CLOSED
  CANCELLED
}

enum MissionEventType {
  CREATED
  ACCEPTED
  CODE_VERIFIED
  DEPARTED
  ARRIVED
  COMPLETED
  CLOSED
  REASSIGNED
}

enum QuoteStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  phone           String     @unique
  firstName       String?
  lastName        String?
  status          UserStatus @default(ACTIVE)
  zoneId          String?    @db.Uuid
  photoDocumentId String?    @unique @db.Uuid
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  zone                    ServiceZone?              @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  photoDocument           Document?                 @relation("UserProfilePhoto", fields: [photoDocumentId], references: [id], onDelete: SetNull)
  roles                   UserRole[]
  sessions                Session[]
  documents               Document[]                @relation("DocumentOwner")
  professionalProfile     ProfessionalProfile?
  adminCredential         AdminCredential?
  dataRequests            DataRequest[]
  sentInvitations         AdminInvitation[]         @relation("AdminInvitationSender")
  devices                 Device[]
  notifications           Notification[]
  evaluationAssignments   EvaluationAssignment[]    @relation("EvaluationEvaluator")
  assignedEvaluations     EvaluationAssignment[]    @relation("EvaluationAssigner")
  evaluationSubmissions   EvaluationSubmission[]    @relation("EvaluationSubmitter")
  serviceRequests         ServiceRequest[]          @relation("ServiceRequestClient")
  missionClients          Mission[]                 @relation("MissionClient")
  favorites               Favorite[]
  conversationMemberships ConversationParticipant[]
  messages                Message[]
  missionEvents           MissionEvent[]
  serviceReports          ServiceReport[]
  paymentIntents          PaymentIntent[]
  feeCharges              FeeCharge[]
  subscriptions           Subscription[]
  reviewsAuthored         Review[]                  @relation("ReviewAuthor")
  claimsFiled             Claim[]                   @relation("Claimant")
  suspensionsActed        Suspension[]              @relation("SuspensionActor")
  appealsSubmitted        Appeal[]                  @relation("AppealSubmitter")
  appealsDecided          Appeal[]                  @relation("AppealDecider")
  legalConsents           LegalConsent[]
  reviewContests          ReviewContest[]

  @@index([zoneId])
  @@map("users")
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  code      RoleCode @unique
  label     String
  createdAt DateTime @default(now())

  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model OtpCode {
  id             String         @id @default(uuid()) @db.Uuid
  phone          String
  codeHash       String
  attempts       Int            @default(0)
  maxAttempts    Int            @default(3)
  expiresAt      DateTime
  consumedAt     DateTime?
  ip             String?
  userAgent      String?
  clientPlatform ClientPlatform @default(UNKNOWN)
  clientDeviceId String?
  createdAt      DateTime       @default(now())

  @@index([phone, createdAt])
  @@map("otp_codes")
}

model Session {
  id                  String         @id @default(uuid()) @db.Uuid
  userId              String         @db.Uuid
  refreshTokenHash    String         @unique
  familyId            String         @db.Uuid
  replacedBySessionId String?        @db.Uuid
  revokedAt           DateTime?
  expiresAt           DateTime
  ip                  String?
  userAgent           String?
  clientPlatform      ClientPlatform @default(UNKNOWN)
  clientDeviceId      String?
  createdAt           DateTime       @default(now())

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy       Session?  @relation("SessionRotation", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  replacedSessions Session[] @relation("SessionRotation")

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model Specialty {
  id        String        @id @default(uuid()) @db.Uuid
  code      SpecialtyCode @unique
  label     String
  sortOrder Int           @default(0)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  professionals ProfessionalSpecialty[]

  @@map("specialties")
}

model ServiceZone {
  id         String                               @id @default(uuid()) @db.Uuid
  code       String                               @unique
  name       String
  department String
  center     Unsupported("geometry(Point,4326)")?
  createdAt  DateTime                             @default(now())
  updatedAt  DateTime                             @updatedAt

  users           User[]
  professionals   ProfessionalZone[]
  serviceRequests ServiceRequest[]

  @@index([department])
  @@map("service_zones")
}

model ProfessionalProfile {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String             @unique @db.Uuid
  status                 ProfessionalStatus @default(PENDING)
  experienceYears        Int                @default(0)
  bio                    String?
  submittedAt            DateTime           @default(now())
  decidedAt              DateTime?
  decisionReason         String?
  complementRequestedAt  DateTime?
  complementDueAt        DateTime?
  submissionCount        Int                @default(1)
  certifiedAt            DateTime?
  evaluationSubmissionId String?            @unique @db.Uuid
  availabilityStatus     AvailabilityStatus @default(AVAILABLE)
  availableFrom          DateTime?
  availableUntil         DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user                    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialties             ProfessionalSpecialty[]
  zones                   ProfessionalZone[]
  decisions               VerificationDecision[]
  evaluationAssignments   EvaluationAssignment[]
  certificationSubmission EvaluationSubmission?   @relation("ProfileCertification", fields: [evaluationSubmissionId], references: [id], onDelete: SetNull)
  favorites               Favorite[]
  proposals               ServiceProposal[]
  missions                Mission[]               @relation("MissionProfessional")
  subscriptions           Subscription[]
  reviews                 Review[]
  reviewResponses         ReviewResponse[]
  claims                  Claim[]
  reputationSnapshots     ReputationSnapshot[]
  suspensions             Suspension[]

  @@index([status])
  @@map("professional_profiles")
}

model ProfessionalSpecialty {
  profileId   String @db.Uuid
  specialtyId String @db.Uuid

  profile   ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  specialty Specialty           @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([profileId, specialtyId])
  @@index([specialtyId])
  @@map("professional_specialties")
}

model ProfessionalZone {
  profileId String @db.Uuid
  zoneId    String @db.Uuid

  profile ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  zone    ServiceZone         @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([profileId, zoneId])
  @@index([zoneId])
  @@map("professional_zones")
}

model Document {
  id                  String         @id @default(uuid()) @db.Uuid
  ownerId             String         @db.Uuid
  type                DocumentType
  status              DocumentStatus @default(PENDING)
  fileName            String
  contentType         String
  detectedContentType String?
  sizeBytes           Int
  sha256              String?
  storageKey          String?
  uploadedAt          DateTime?
  expiresAt           DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  owner                User                  @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  profilePhotoOf       User?                 @relation("UserProfilePhoto")
  events               DocumentEvent[]
  reminders            DocumentReminder[]
  serviceRequestPhotos ServiceRequestPhoto[]

  @@index([ownerId])
  @@index([type])
  @@index([status])
  @@index([expiresAt])
  @@map("documents")
}

model OtpDelivery {
  id        String         @id @default(uuid()) @db.Uuid
  phone     String
  channel   OtpChannel     @default(SMS)
  status    DeliveryStatus @default(QUEUED)
  attempts  Int            @default(0)
  error     String?
  createdAt DateTime       @default(now())
  sentAt    DateTime?

  @@index([phone, createdAt])
  @@index([status])
  @@map("otp_deliveries")
}

model AdminCredential {
  userId              String    @id @db.Uuid
  passwordHash        String
  passwordChangedAt   DateTime  @default(now())
  totpSecret          String?
  totpEnabledAt       DateTime?
  totpLastUsedStep    Int?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_credentials")
}

model AdminInvitation {
  id              String           @id @default(uuid()) @db.Uuid
  phone           String
  email           String?
  role            RoleCode
  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  invitedByUserId String?          @db.Uuid
  createdAt       DateTime         @default(now())

  invitedBy User? @relation("AdminInvitationSender", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([phone])
  @@index([status])
  @@map("admin_invitations")
}

model DataRequest {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @db.Uuid
  type           DataRequestType
  status         DataRequestStatus @default(PENDING)
  details        String?
  resolutionNote String?
  requestedAt    DateTime          @default(now())
  resolvedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt])
  @@index([status])
  @@map("data_requests")
}

model DocumentEvent {
  id         String            @id @default(uuid()) @db.Uuid
  documentId String            @db.Uuid
  type       DocumentEventType
  actorId    String?           @db.Uuid
  metadata   Json?
  createdAt  DateTime          @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@index([type])
  @@map("document_events")
}

model AuditLog {
  id           BigInt      @id @default(autoincrement()) @db.BigInt
  actorId      String?     @db.Uuid
  actorRole    String?
  action       String
  targetType   String?
  targetId     String?
  before       Json?
  after        Json?
  ip           String?
  userAgent    String?
  sessionId    String?     @db.Uuid
  requestId    String?
  deviceId     String?
  result       AuditResult @default(SUCCESS)
  reason       String?
  previousHash String?
  hash         String?
  createdAt    DateTime    @default(now())

  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([requestId])
  @@map("audit_logs")
}

model VerificationDecision {
  id              String                   @id @default(uuid()) @db.Uuid
  profileId       String                   @db.Uuid
  adminId         String                   @db.Uuid
  decision        VerificationDecisionType
  reasonCode      VerifiedReasonCode
  reasonText      String
  requestedItems  Json?
  complementDueAt DateTime?
  idempotencyKey  String?
  requestHash     String?
  createdAt       DateTime                 @default(now())

  profile ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([adminId, idempotencyKey])
  @@index([profileId, createdAt])
  @@index([decision, createdAt])
  @@map("verification_decisions")
}

model IdempotencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  scope       String
  adminId     String   @db.Uuid
  key         String
  requestHash String
  status      Int
  response    Json
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([scope, adminId, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model Device {
  id                   String         @id @default(uuid()) @db.Uuid
  userId               String         @db.Uuid
  deviceId             String
  platform             DevicePlatform
  pushProvider         PushProvider   @default(WEB_PUSH)
  pushToken            String?
  pushSubscription     Json?
  appVersion           String?
  osVersion            String?
  locale               String?
  notificationsEnabled Boolean        @default(true)
  lastSeenAt           DateTime       @default(now())
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  revokedAt            DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId, revokedAt])
  @@index([pushProvider])
  @@map("devices")
}

model Notification {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  type      NotificationType
  title     String
  body      String
  entityId  String?
  route     String?
  data      Json?
  status    NotificationStatus @default(PENDING)
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime           @default(now())

  user   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  outbox NotificationOutbox[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("notifications")
}

model NotificationOutbox {
  id             String         @id @default(uuid()) @db.Uuid
  notificationId String         @db.Uuid
  deviceId       String?
  channel        String
  payload        Json
  status         DeliveryStatus @default(QUEUED)
  attempts       Int            @default(0)
  lastError      String?
  availableAt    DateTime       @default(now())
  createdAt      DateTime       @default(now())
  sentAt         DateTime?

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([notificationId])
  @@map("notification_outbox")
}

model DocumentReminder {
  id            String         @id @default(uuid()) @db.Uuid
  documentId    String         @db.Uuid
  thresholdDays Int
  scheduledFor  DateTime
  status        DeliveryStatus @default(QUEUED)
  attempts      Int            @default(0)
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime       @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, thresholdDays])
  @@index([status, scheduledFor])
  @@map("document_reminders")
}

model EvaluationGrid {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  label       String
  description String?
  version     Int      @default(1)
  passScore   Int      @default(70)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  criteria    EvaluationCriterion[]
  assignments EvaluationAssignment[]

  @@index([active])
  @@map("evaluation_grids")
}

model EvaluationCriterion {
  id          String   @id @default(uuid()) @db.Uuid
  gridId      String   @db.Uuid
  code        String
  label       String
  description String?
  weight      Int
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  grid    EvaluationGrid     @relation(fields: [gridId], references: [id], onDelete: Cascade)
  results EvaluationResult[]

  @@unique([gridId, code])
  @@index([gridId, sortOrder])
  @@map("evaluation_criteria")
}

model EvaluationAssignment {
  id                String                     @id @default(uuid()) @db.Uuid
  gridId            String                     @db.Uuid
  profileId         String                     @db.Uuid
  evaluatorId       String                     @db.Uuid
  assignedByAdminId String                     @db.Uuid
  status            EvaluationAssignmentStatus @default(ASSIGNED)
  dueAt             DateTime?
  notes             String?
  submittedAt       DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  grid       EvaluationGrid        @relation(fields: [gridId], references: [id], onDelete: Restrict)
  profile    ProfessionalProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  evaluator  User                  @relation("EvaluationEvaluator", fields: [evaluatorId], references: [id], onDelete: Restrict)
  assignedBy User                  @relation("EvaluationAssigner", fields: [assignedByAdminId], references: [id], onDelete: Restrict)
  results    EvaluationResult[]
  submission EvaluationSubmission? @relation("AssignmentSubmission")

  @@unique([profileId, gridId])
  @@index([evaluatorId, status])
  @@index([profileId])
  @@index([status, dueAt])
  @@map("evaluation_assignments")
}

model EvaluationResult {
  id           String   @id @default(uuid()) @db.Uuid
  assignmentId String   @db.Uuid
  criterionId  String   @db.Uuid
  score        Int
  comment      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignment EvaluationAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  criterion  EvaluationCriterion  @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, criterionId])
  @@index([criterionId])
  @@map("evaluation_results")
}

model EvaluationSubmission {
  id           String   @id @default(uuid()) @db.Uuid
  assignmentId String   @unique @db.Uuid
  evaluatorId  String   @db.Uuid
  score        Int
  passed       Boolean
  createdAt    DateTime @default(now())

  assignment       EvaluationAssignment @relation("AssignmentSubmission", fields: [assignmentId], references: [id], onDelete: Cascade)
  evaluator        User                 @relation("EvaluationSubmitter", fields: [evaluatorId], references: [id], onDelete: Restrict)
  certifiedProfile ProfessionalProfile? @relation("ProfileCertification")

  @@index([passed, createdAt])
  @@map("evaluation_submissions")
}

model ServiceRequest {
  id          String               @id @default(uuid()) @db.Uuid
  clientId    String               @db.Uuid
  type        ServiceRequestType
  urgency     UrgencyLevel
  zoneId      String               @db.Uuid
  description String
  status      ServiceRequestStatus @default(OPEN)
  cancelledAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  client    User                  @relation("ServiceRequestClient", fields: [clientId], references: [id], onDelete: Cascade)
  zone      ServiceZone           @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  photos    ServiceRequestPhoto[]
  proposals ServiceProposal[]
  mission   Mission?

  @@index([clientId, createdAt])
  @@index([zoneId, status])
  @@map("service_requests")
}

model ServiceRequestPhoto {
  id         String   @id @default(uuid()) @db.Uuid
  requestId  String   @db.Uuid
  documentId String   @unique @db.Uuid
  createdAt  DateTime @default(now())

  request  ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  document Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("service_request_photos")
}

model Favorite {
  clientId              String   @db.Uuid
  professionalProfileId String   @db.Uuid
  createdAt             DateTime @default(now())

  client              User                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@id([clientId, professionalProfileId])
  @@index([professionalProfileId])
  @@map("favorites")
}

model ServiceProposal {
  id                    String         @id @default(uuid()) @db.Uuid
  requestId             String         @db.Uuid
  professionalProfileId String         @db.Uuid
  message               String
  status                ProposalStatus @default(PENDING)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  request             ServiceRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  mission             Mission?

  @@unique([requestId, professionalProfileId])
  @@index([professionalProfileId, status])
  @@map("service_proposals")
}

model Mission {
  id                     String        @id @default(uuid()) @db.Uuid
  requestId              String        @unique @db.Uuid
  proposalId             String?       @unique @db.Uuid
  clientId               String        @db.Uuid
  professionalProfileId  String        @db.Uuid
  status                 MissionStatus @default(ACCEPTED)
  arrivalCodeHash        String?
  arrivalCodeExpiresAt   DateTime?
  arrivalCodeAttempts    Int           @default(0)
  arrivalCodeUsedAt      DateTime?
  previousProfessionalId String?       @db.Uuid
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  request             ServiceRequest      @relation(fields: [requestId], references: [id], onDelete: Restrict)
  proposal            ServiceProposal?    @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  client              User                @relation("MissionClient", fields: [clientId], references: [id], onDelete: Restrict)
  professionalProfile ProfessionalProfile @relation("MissionProfessional", fields: [professionalProfileId], references: [id], onDelete: Restrict)
  conversation        Conversation?
  quotes              Quote[]
  events              MissionEvent[]
  positions           MissionPosition[]
  report              ServiceReport?
  paymentIntents      PaymentIntent[]
  feeCharges          FeeCharge[]
  guarantees          Guarantee[]
  claims              Claim[]
  review              Review?

  @@index([clientId, createdAt])
  @@index([professionalProfileId, status])
  @@index([status])
  @@map("missions")
}

model Conversation {
  id            String   @id @default(uuid()) @db.Uuid
  missionId     String   @unique @db.Uuid
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  mission      Mission                   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId    String    @db.Uuid
  userId            String    @db.Uuid
  lastReadMessageId BigInt?   @db.BigInt
  lastReadAt        DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             BigInt    @id @default(autoincrement()) @db.BigInt
  conversationId String    @db.Uuid
  senderId       String    @db.Uuid
  body           String
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId, id])
  @@index([conversationId, createdAt])
  @@map("messages")
}

model Quote {
  id         String      @id @default(uuid()) @db.Uuid
  missionId  String      @db.Uuid
  version    Int
  status     QuoteStatus @default(DRAFT)
  validUntil DateTime
  totalCents Int
  currency   String      @default("XOF")
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  mission Mission     @relation(fields: [missionId], references: [id], onDelete: Cascade)
  lines   QuoteLine[]

  @@unique([missionId, version])
  @@index([missionId, status])
  @@map("quotes")
}

model QuoteLine {
  id             String @id @default(uuid()) @db.Uuid
  quoteId        String @db.Uuid
  label          String
  quantity       Int
  unitPriceCents Int
  sortOrder      Int    @default(0)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, sortOrder])
  @@map("quote_lines")
}

model MissionEvent {
  id        BigInt           @id @default(autoincrement()) @db.BigInt
  missionId String           @db.Uuid
  type      MissionEventType
  actorId   String           @db.Uuid
  metadata  Json?
  createdAt DateTime         @default(now())

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  actor   User    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([missionId, id])
  @@index([missionId, createdAt])
  @@map("mission_events")
}

model MissionPosition {
  id             BigInt   @id @default(autoincrement()) @db.BigInt
  missionId      String   @db.Uuid
  lat            Float
  lng            Float
  accuracyMeters Int?
  recordedAt     DateTime
  createdAt      DateTime @default(now())

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId, id])
  @@index([createdAt])
  @@map("mission_positions")
}

model ServiceReport {
  id        String   @id @default(uuid()) @db.Uuid
  missionId String   @unique @db.Uuid
  authorId  String   @db.Uuid
  summary   String
  checklist Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@map("service_reports")
}

enum PaymentProvider {
  CINETPAY
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
  REFUNDED
}

enum ProviderEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum LedgerAccountType {
  USER
  PROFESSIONAL
  PLATFORM
  PROVIDER
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum LedgerEntryReason {
  PAYMENT
  COMMISSION
  MATCHING_FEE
  VERIFICATION_FEE
  PAYOUT
  REVERSAL
  SUBSCRIPTION
  ADJUSTMENT
}

enum FeeKind {
  COMMISSION
  MATCHING
  VERIFICATION
  SUBSCRIPTION
}

enum SubscriptionPlan {
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum ReconciliationStatus {
  OK
  DISCREPANCY
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  SUSPICIOUS
  REJECTED
  CONTESTED
}

enum SuspicionReason {
  VELOCITY
  DUPLICATE_TEXT
  DUPLICATE_PAIR
  SELF_REVIEW
  LOW_SCORE_BURST
}

enum ReputationLevel {
  BRONZE
  ARGENT
  OR
  PLATINE
}

enum ClaimStatus {
  OPEN
  ACKNOWLEDGED
  INVESTIGATING
  ESCALATED
  RESOLVED
  REJECTED
}

enum GuaranteeStatus {
  ACTIVE
  CLAIMED
  EXPIRED
  VOID
}

enum SuspensionStatus {
  ACTIVE
  APPEALED
  LIFTED
  REJECTED
}

enum AppealStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum LegalDocumentType {
  TERMS
  PRIVACY
  GEO_CONSENT
}

enum BackupStatus {
  SUCCESS
  FAILED
}

model CommissionRate {
  id            String   @id @default(uuid()) @db.Uuid
  rateBps       Int
  effectiveFrom DateTime @unique
  createdAt     DateTime @default(now())

  @@map("commission_rates")
}

model PaymentIntent {
  id                String          @id @default(uuid()) @db.Uuid
  reference         String          @unique
  clientId          String          @db.Uuid
  missionId         String?         @unique @db.Uuid
  subscriptionId    String?         @db.Uuid
  provider          PaymentProvider
  amountCents       Int
  currency          String          @default("XOF")
  status            PaymentStatus   @default(PENDING)
  providerPaymentId String?
  checkoutUrl       String?
  expiresAt         DateTime
  confirmedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  client       User          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  mission      Mission?      @relation(fields: [missionId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([status])
  @@map("payment_intents")
}

model ProviderWebhookEvent {
  id             String              @id @default(uuid()) @db.Uuid
  provider       PaymentProvider
  eventId        String              @unique
  eventType      String
  signatureValid Boolean
  payloadHash    String
  status         ProviderEventStatus @default(RECEIVED)
  error          String?
  receivedAt     DateTime            @default(now())
  processedAt    DateTime?

  @@index([provider, receivedAt])
  @@map("provider_webhook_events")
}

model LedgerAccount {
  id        String            @id @default(uuid()) @db.Uuid
  ownerType LedgerAccountType
  ownerId   String?           @db.Uuid
  currency  String            @default("XOF")
  createdAt DateTime          @default(now())

  entries LedgerEntry[]

  @@unique([ownerType, ownerId, currency])
  @@map("ledger_accounts")
}

model LedgerEntry {
  id                BigInt            @id @default(autoincrement()) @db.BigInt
  accountId         String            @db.Uuid
  entryType         LedgerEntryType
  amountCents       Int
  reason            LedgerEntryReason
  reference         String            @unique
  priorBalanceCents Int
  balanceCents      Int
  reversalOfId      BigInt?           @db.BigInt
  metadata          Json?
  createdAt         DateTime          @default(now())

  account    LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  reversalOf LedgerEntry?  @relation("LedgerReversal", fields: [reversalOfId], references: [id])
  reversals  LedgerEntry[] @relation("LedgerReversal")

  @@index([accountId, id])
  @@map("ledger_entries")
}

model FeeCharge {
  id          String   @id @default(uuid()) @db.Uuid
  missionId   String?  @db.Uuid
  userId      String?  @db.Uuid
  kind        FeeKind
  amountCents Int
  currency    String   @default("XOF")
  reference   String   @unique
  metadata    Json?
  createdAt   DateTime @default(now())

  mission Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([missionId, kind])
  @@map("fee_charges")
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String             @db.Uuid
  professionalProfileId  String?            @db.Uuid
  plan                   SubscriptionPlan
  status                 SubscriptionStatus @default(ACTIVE)
  startedAt              DateTime           @default(now())
  currentPeriodEnd       DateTime
  cancelledAt            DateTime?
  autoRenew              Boolean            @default(true)
  providerSubscriptionId String?            @unique
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user           User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  professional   ProfessionalProfile? @relation(fields: [professionalProfileId], references: [id], onDelete: SetNull)
  paymentIntents PaymentIntent[]

  @@index([userId, status])
  @@map("subscriptions")
}

model ReconciliationReport {
  id               String               @id @default(uuid()) @db.Uuid
  date             DateTime             @db.Date
  status           ReconciliationStatus
  expectedCents    Int
  actualCents      Int
  discrepancyCents Int
  details          Json
  createdAt        DateTime             @default(now())

  @@unique([date])
  @@map("reconciliation_reports")
}

model Review {
  id                    String       @id @default(uuid()) @db.Uuid
  missionId             String       @unique @db.Uuid
  authorId              String       @db.Uuid
  professionalProfileId String       @db.Uuid
  quality               Int
  timeliness            Int
  behaviour             Int
  quoteCompliance       Int
  safety                Int
  weightedScore         Float
  comment               String?
  status                ReviewStatus @default(PUBLISHED)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  mission  Mission             @relation(fields: [missionId], references: [id], onDelete: Restrict)
  author   User                @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  profile  ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  flags    ReviewFlag[]
  response ReviewResponse?
  contest  ReviewContest?

  @@index([professionalProfileId, createdAt])
  @@map("reviews")
}

model ReviewFlag {
  id        BigInt          @id @default(autoincrement()) @db.BigInt
  reviewId  String          @db.Uuid
  reason    SuspicionReason
  detail    Json?
  createdAt DateTime        @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_flags")
}

model ReviewResponse {
  id                    String   @id @default(uuid()) @db.Uuid
  reviewId              String   @unique @db.Uuid
  professionalProfileId String   @db.Uuid
  body                  String
  createdAt             DateTime @default(now())

  review  Review              @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  profile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)

  @@map("review_responses")
}

model ReviewContest {
  id        String       @id @default(uuid()) @db.Uuid
  reviewId  String       @unique @db.Uuid
  authorId  String       @db.Uuid
  body      String
  status    AppealStatus @default(PENDING)
  createdAt DateTime     @default(now())
  decidedAt DateTime?

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@map("review_contests")
}

model ReputationSnapshot {
  id                    BigInt          @id @default(autoincrement()) @db.BigInt
  professionalProfileId String          @db.Uuid
  score                 Float
  level                 ReputationLevel
  missionCount          Int
  createdAt             DateTime        @default(now())

  profile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@index([professionalProfileId, createdAt])
  @@map("reputation_snapshots")
}

model Claim {
  id                  String      @id @default(uuid()) @db.Uuid
  number              String      @unique
  missionId           String?     @db.Uuid
  claimantId          String      @db.Uuid
  respondentProfileId String?     @db.Uuid
  subject             String
  description         String
  status              ClaimStatus @default(OPEN)
  ackDueAt            DateTime
  resolutionDueAt     DateTime
  acknowledgedAt      DateTime?
  resolvedAt          DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  mission    Mission?             @relation(fields: [missionId], references: [id], onDelete: SetNull)
  claimant   User                 @relation("Claimant", fields: [claimantId], references: [id], onDelete: Restrict)
  respondent ProfessionalProfile? @relation(fields: [respondentProfileId], references: [id], onDelete: SetNull)

  @@index([status, resolutionDueAt])
  @@map("claims")
}

model Guarantee {
  id            String          @id @default(uuid()) @db.Uuid
  missionId     String          @unique @db.Uuid
  coverageCents Int
  currency      String          @default("XOF")
  validFrom     DateTime
  validUntil    DateTime
  status        GuaranteeStatus @default(ACTIVE)
  createdAt     DateTime        @default(now())

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([status, validUntil])
  @@map("guarantees")
}

model Suspension {
  id                    String           @id @default(uuid()) @db.Uuid
  professionalProfileId String           @db.Uuid
  reason                String
  evidence              Json?
  suspendedBy           String           @db.Uuid
  startedAt             DateTime         @default(now())
  endsAt                DateTime?
  status                SuspensionStatus @default(ACTIVE)
  liftedAt              DateTime?
  createdAt             DateTime         @default(now())

  profile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  actor   User                @relation("SuspensionActor", fields: [suspendedBy], references: [id], onDelete: Restrict)
  appeals Appeal[]

  @@index([professionalProfileId, status])
  @@map("suspensions")
}

model Appeal {
  id           String       @id @default(uuid()) @db.Uuid
  suspensionId String       @db.Uuid
  submittedBy  String       @db.Uuid
  body         String
  status       AppealStatus @default(PENDING)
  decidedBy    String?      @db.Uuid
  decidedAt    DateTime?
  createdAt    DateTime     @default(now())

  suspension Suspension @relation(fields: [suspensionId], references: [id], onDelete: Cascade)
  submitter  User       @relation("AppealSubmitter", fields: [submittedBy], references: [id], onDelete: Restrict)
  decider    User?      @relation("AppealDecider", fields: [decidedBy], references: [id], onDelete: SetNull)

  @@index([suspensionId, status])
  @@map("appeals")
}

model LegalDocument {
  id          String            @id @default(uuid()) @db.Uuid
  type        LegalDocumentType
  version     String
  title       String
  content     String
  publishedAt DateTime          @default(now())
  createdAt   DateTime          @default(now())

  consents LegalConsent[]

  @@unique([type, version])
  @@map("legal_documents")
}

model LegalConsent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  documentId String   @db.Uuid
  acceptedAt DateTime @default(now())
  ip         String?
  userAgent  String?

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  document LegalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([userId, documentId])
  @@map("legal_consents")
}

model BackupRecord {
  id          String       @id @default(uuid()) @db.Uuid
  status      BackupStatus
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  sizeBytes   Int?
  location    String?
  checksum    String?
  restoredAt  DateTime?

  @@index([startedAt])
  @@map("backup_records")
}
