NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://electro:electro@localhost:5432/electro_assist?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-with-at-least-32-characters-long
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
REFRESH_TOKEN_PEPPER=change-me-with-at-least-16-characters

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_REQUEST_COOLDOWN_SECONDS=60
OTP_MAX_PER_PHONE_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=10
OTP_MAX_PER_DEVICE_PER_HOUR=5
OTP_FIXED_CODE=
OTP_FIXED_PHONES=+22900000001,+22900000002,+22900000003,+22900000004

ADMIN_PHONE=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_INVITE_TTL_SECONDS=604800
ADMIN_LOGIN_MAX_PER_HOUR=5
ADMIN_LOGIN_LOCK_MINUTES=15
ADMIN_MFA_TTL_SECONDS=300
TOTP_ISSUER=Electro Assist 24H

CORS_ORIGINS=http://localhost:5173

DOCUMENT_SIGNING_SECRET=change-me-document-signing-secret-32
DOCUMENT_STORAGE_DIR=./storage/private
DOCUMENT_MAX_UPLOAD_BYTES=10485760
DOCUMENT_EXPIRY_DAYS=365
DOCUMENT_SIGNED_URL_TTL_SECONDS=600
APP_VERSION=0.1.0

AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
